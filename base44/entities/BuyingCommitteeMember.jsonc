{
  "name": "BuyingCommitteeMember",
  "type": "object",
  "properties": {
    "account": {
      "type": "string"
    },
    "personName": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "roleType": {
      "type": "string",
      "enum": [
        "Economic Buyer",
        "Champion",
        "Technical Buyer",
        "User",
        "Risk",
        "Commercial",
        "Influencer"
      ]
    },
    "linkedinUrl": {
      "type": "string"
    },
    "influence": {
      "type": "number"
    },
    "likelyPriority": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "supportingEvidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "account",
    "roleType"
  ]
}